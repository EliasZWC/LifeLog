<?xml version="1.0" encoding="utf-8"?>
<!--
  Livolog 应用图标 · 前景层
  造型：白 → 灰 逆时针环绕渐变的时钟（圆环 + 中心指针）

  几何（108 × 108 视口，等于 Android VectorDrawable 的坐标空间）
    整体缩放：设计稿（外径 66）等比缩到 s = 21/33 ≈ 0.6364。
              自适应图标的外圈 18dp 可能被裁，而「圆形遮罩」的可见直径只有 66（= 设计稿的外径），
              贴边会显得很挤，所以圆环外径收到 **42**：到 66dp 安全圆留 12、到 72dp 遮罩留 15。
    圆心           (54, 54)
    圆环外半径     21   → 外径 42
    圆环线宽       4.45 → 内半径 16.55
    圆环中线半径   18.77 → 两端的圆头 / 1 点的圆点都画在这条线上
    圆头半径       2.23
    圆弧跨度       12 点起「逆时针」300°：12 点 → 9 点 → 6 点 → 3 点 → 2 点
    分针           10.18 长，指向 12 点（顺时针 0°）
    时针           7.00 长，指向 8 点方向（顺时针 240°）
    两针线宽       3.82 → 半宽 1.91
    中心圆点       半径 1.91（= 半宽，与两针相切，正好填平圆心的凹角）

  渐变：圆环用 <gradient type="sweep">。
  注意 Android 的 sweep 渐变**没有起点角度参数**（GradientColor.onColorsChange()
  里就是 `new SweepGradient(centerX, centerY, colors, offsets)`），
  它固定从「3 点方向」起、沿顺时针走一圈，offset 0→1 对应 0°→360°。
  换算（记 φ = 从 12 点起顺时针的角度，σ = 从 3 点起顺时针的角度 = φ - 90）：
    - 12 点 φ=0   → σ=270  → offset 0.75   → 纯白 #FFFFFF
    -  2 点 φ=60  → σ=330  → offset 0.9167 → 最深的灰 #6E6E6E
    -  3 点 φ=90  → σ=0/360 → offset 0 / 1  → #7C7C7C（两端必须同色才接得上）
  白→灰的过渡在 φ ∈ [60°, 360°] 上是线性的，所以按上面取值正好吻合；
  σ ∈ (270°, 330°) 那一段（φ ∈ (0°, 60°)）是缺口、根本不画，随便填。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ① 圆环：从 3 点方向顺时针绕到 12 点的圆环扇形（缺口在 12 点～2 点之间） -->
    <path android:pathData="M72.19,43.5 A21,21 0 1 1 54,33 L54,37.45 A16.55,16.55 0 1 0 68.33,45.73 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="sweep"
                android:centerX="54"
                android:centerY="54">
                <item
                    android:offset="0"
                    android:color="#FF7C7C7C" />
                <item
                    android:offset="0.75"
                    android:color="#FFFFFFFF" />
                <item
                    android:offset="0.9167"
                    android:color="#FF6E6E6E" />
                <item
                    android:offset="1"
                    android:color="#FF7C7C7C" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- ② 圆弧起点的圆头：12 点方向，纯白（半径 2.23，圆心 54,35.23） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M51.77,35.23 a2.23,2.23 0 1 0 4.46,0 a2.23,2.23 0 1 0 -4.46,0 Z" />

    <!-- ③ 圆弧尾部的圆头：2 点方向，最深的灰（圆心 70.26,44.62） -->
    <path
        android:fillColor="#FF6E6E6E"
        android:pathData="M68.03,44.62 a2.23,2.23 0 1 0 4.46,0 a2.23,2.23 0 1 0 -4.46,0 Z" />

    <!-- ④ 1 点方向的独立圆点：和圆头一样大，用圆弧尾部最深的灰（圆心 63.39,37.74） -->
    <path
        android:fillColor="#FF6E6E6E"
        android:pathData="M61.16,37.74 a2.23,2.23 0 1 0 4.46,0 a2.23,2.23 0 1 0 -4.46,0 Z" />

    <!--
      ⑤ 指针（两针同粗 3.82，圆头）
         分针：圆心 → 12 点方向，长 10.18
         时针：圆心 → 8 点方向，长 7.00
         根部用圆头会往外鼓半个线宽，但半径 1.91 的圆头完全落在下面那个中心圆点里，
         所以最终轮廓 = 中心圆点 ∪ 两针，和设计稿一致。
    -->
    <path
        android:pathData="M54,54 L54,43.82 M54,54 L47.94,57.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="3.82" />

    <!-- ⑥ 中心圆点：半径 1.91 = 指针半宽，与两针的边相切，填平圆心缺口且不外溢 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M52.09,54 a1.91,1.91 0 1 0 3.82,0 a1.91,1.91 0 1 0 -3.82,0 Z" />
</vector>
