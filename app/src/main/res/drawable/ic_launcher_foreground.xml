<?xml version="1.0" encoding="utf-8"?>
<!--
  LifeLog 应用图标 · 前景层
  造型：白 → 灰 逆时针环绕渐变的时钟（圆环 + 中心指针）

  几何（108 × 108 视口，等于 Android VectorDrawable 的坐标空间）
    整体缩放：设计稿（外径 66）等比缩到 s = 28/33 ≈ 0.8485 —— 自适应图标的外圈 18dp 可能被裁，
              内容貼着边界会显得很挤，所以圆环外径从 66 收到 **56**，四周留出约 4.6dp 的空白。
    圆心           (54, 54)
    圆环外半径     28   → 外径 56
    圆环线宽       5.09 → 内半径 22.06
    圆环中线半径   25.03 → 两端的圆头 / 1 点的圆点都画在这条线上
    圆头半径       2.97
    圆弧跨度       12 点起「逆时针」300°：12 点 → 9 点 → 6 点 → 3 点 → 2 点
    分针           13.58 长，指向 12 点（顺时针 0°）
    时针           9.33 长，指向 8 点方向（顺时针 240°）
    两针线宽       5.09 → 半宽 2.55
    中心圆点       半径 2.55（= 半宽，与两针相切，正好填平圆心的凹角）

  渐变：圆环用 <gradient type="sweep">。
  注意 Android 的 sweep 渐变**没有起点角度参数**（GradientColor.onColorsChange()
  里就是 `new SweepGradient(centerX, centerY, colors, offsets)`），
  它固定从「3 点方向」起、沿顺时针走一圈，offset 0→1 对应 0°→360°。
  换算（记 φ = 从 12 点起顺时针的角度，σ = 从 3 点起顺时针的角度 = φ - 90）：
    - 12 点 φ=0   → σ=270  → offset 0.75   → 纯白 #FFFFFF
    -  2 点 φ=60  → σ=330  → offset 0.9167 → 最深的灰 #6E6E6E
    -  3 点 φ=90  → σ=0/360 → offset 0 / 1  → #7C7C7C（两端必须同色才接得上）
  白→灰的过渡在 φ ∈ [60°, 360°] 上是线性的，所以按上面取值正好吻合；
  σ ∈ (270°, 330°) 那一段（φ ∈ (0°, 60°)）是缺口、根本不画，随便填。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ① 圆环：从 3 点方向顺时针绕到 12 点的圆环扇形（缺口在 12 点～2 点之间） -->
    <path android:pathData="M78.25,40 A28,28 0 1 1 54,26 L54,31.94 A22.06,22.06 0 1 0 73.11,42.97 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="sweep"
                android:centerX="54"
                android:centerY="54">
                <item
                    android:offset="0"
                    android:color="#FF7C7C7C" />
                <item
                    android:offset="0.75"
                    android:color="#FFFFFFFF" />
                <item
                    android:offset="0.9167"
                    android:color="#FF6E6E6E" />
                <item
                    android:offset="1"
                    android:color="#FF7C7C7C" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- ② 圆弧起点的圆头：12 点方向，纯白（半径 2.97，圆心 54,28.97） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M51.03,28.97 a2.97,2.97 0 1 0 5.94,0 a2.97,2.97 0 1 0 -5.94,0 Z" />

    <!-- ③ 圆弧尾部的圆头：2 点方向，最深的灰（圆心 75.68,41.49） -->
    <path
        android:fillColor="#FF6E6E6E"
        android:pathData="M72.71,41.49 a2.97,2.97 0 1 0 5.94,0 a2.97,2.97 0 1 0 -5.94,0 Z" />

    <!-- ④ 1 点方向的独立圆点：和圆头一样大，用圆弧尾部最深的灰（圆心 66.52,32.32） -->
    <path
        android:fillColor="#FF6E6E6E"
        android:pathData="M63.55,32.32 a2.97,2.97 0 1 0 5.94,0 a2.97,2.97 0 1 0 -5.94,0 Z" />

    <!--
      ⑤ 指针（两针同粗 5.09，圆头）
         分针：圆心 → 12 点方向，长 13.58
         时针：圆心 → 8 点方向，长 9.33
         根部用圆头会往外鼓半个线宽，但半径 2.55 的圆头完全落在下面那个中心圆点里，
         所以最终轮廓 = 中心圆点 ∪ 两针，和设计稿一致。
    -->
    <path
        android:pathData="M54,54 L54,40.42 M54,54 L45.92,58.67"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="5.09" />

    <!-- ⑥ 中心圆点：半径 2.55 = 指针半宽，与两针的边相切，填平圆心缺口且不外溢 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M51.45,54 a2.55,2.55 0 1 0 5.1,0 a2.55,2.55 0 1 0 -5.1,0 Z" />
</vector>
