<?xml version="1.0" encoding="utf-8"?>
<!--
  Livolog 应用图标 · 前景层
  造型：白 → 灰 逆时针环绕渐变的时钟（圆环 + 中心指针）

  几何（108 × 108 视口，等于 Android VectorDrawable 的坐标空间）
    整体缩放：设计稿（外径 66）等比缩到 s = 25/33 ≈ 0.7576。
              自适应图标的外圈 18dp 可能被裁，而「圆形遮罩」的可见直径只有 66（= 设计稿的外径），
              贴边会显得很挤，所以圆环外径收到 **50**：到 66dp 安全圆还留 8、到 72dp 遮罩留 11。
    圆心           (54, 54)
    圆环外半径     25   → 外径 50
    圆环线宽       5.30 → 内半径 19.70
    圆环中线半径   22.35 → 两端的圆头 / 1 点的圆点都画在这条线上
    圆头半径       2.65
    圆弧跨度       12 点起「逆时针」300°：12 点 → 9 点 → 6 点 → 3 点 → 2 点
    分针           12.12 长，指向 12 点（顺时针 0°）
    时针           8.33 长，指向 8 点方向（顺时针 240°）
    两针线宽       4.55 → 半宽 2.27
    中心圆点       半径 2.27（= 半宽，与两针相切，正好填平圆心的凹角）

  渐变：圆环用 <gradient type="sweep">。
  注意 Android 的 sweep 渐变**没有起点角度参数**（GradientColor.onColorsChange()
  里就是 `new SweepGradient(centerX, centerY, colors, offsets)`），
  它固定从「3 点方向」起、沿顺时针走一圈，offset 0→1 对应 0°→360°。
  换算（记 φ = 从 12 点起顺时针的角度，σ = 从 3 点起顺时针的角度 = φ - 90）：
    - 12 点 φ=0   → σ=270  → offset 0.75   → 纯白 #FFFFFF
    -  2 点 φ=60  → σ=330  → offset 0.9167 → 最深的灰 #6E6E6E
    -  3 点 φ=90  → σ=0/360 → offset 0 / 1  → #7C7C7C（两端必须同色才接得上）
  白→灰的过渡在 φ ∈ [60°, 360°] 上是线性的，所以按上面取值正好吻合；
  σ ∈ (270°, 330°) 那一段（φ ∈ (0°, 60°)）是缺口、根本不画，随便填。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ① 圆环：从 3 点方向顺时针绕到 12 点的圆环扇形（缺口在 12 点～2 点之间） -->
    <path android:pathData="M75.65,41.5 A25,25 0 1 1 54,29 L54,34.3 A19.7,19.7 0 1 0 71.06,44.15 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="sweep"
                android:centerX="54"
                android:centerY="54">
                <item
                    android:offset="0"
                    android:color="#FF7C7C7C" />
                <item
                    android:offset="0.75"
                    android:color="#FFFFFFFF" />
                <item
                    android:offset="0.9167"
                    android:color="#FF6E6E6E" />
                <item
                    android:offset="1"
                    android:color="#FF7C7C7C" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- ② 圆弧起点的圆头：12 点方向，纯白（半径 2.65，圆心 54,31.65） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M51.35,31.65 a2.65,2.65 0 1 0 5.3,0 a2.65,2.65 0 1 0 -5.3,0 Z" />

    <!-- ③ 圆弧尾部的圆头：2 点方向，最深的灰（圆心 73.35,42.83） -->
    <path
        android:fillColor="#FF6E6E6E"
        android:pathData="M70.7,42.83 a2.65,2.65 0 1 0 5.3,0 a2.65,2.65 0 1 0 -5.3,0 Z" />

    <!-- ④ 1 点方向的独立圆点：和圆头一样大，用圆弧尾部最深的灰（圆心 65.17,34.65） -->
    <path
        android:fillColor="#FF6E6E6E"
        android:pathData="M62.52,34.65 a2.65,2.65 0 1 0 5.3,0 a2.65,2.65 0 1 0 -5.3,0 Z" />

    <!--
      ⑤ 指针（两针同粗 4.55，圆头）
         分针：圆心 → 12 点方向，长 12.12
         时针：圆心 → 8 点方向，长 8.33
         根部用圆头会往外鼓半个线宽，但半径 2.27 的圆头完全落在下面那个中心圆点里，
         所以最终轮廓 = 中心圆点 ∪ 两针，和设计稿一致。
    -->
    <path
        android:pathData="M54,54 L54,41.88 M54,54 L46.79,58.17"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="4.55" />

    <!-- ⑥ 中心圆点：半径 2.27 = 指针半宽，与两针的边相切，填平圆心缺口且不外溢 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M51.73,54 a2.27,2.27 0 1 0 4.54,0 a2.27,2.27 0 1 0 -4.54,0 Z" />
</vector>
